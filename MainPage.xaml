<Page x:Class="VoiceTools.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid Background="LightGray">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <RelativePanel x:Name="MainRelativePanel" Grid.Row="0">
   <Button x:Name="Hamburgertestbutton" RelativePanel.AlignLeftWithPanel="True" FontFamily="Segoe MDL2 Assets" Content="&#xE700;" FontSize="30" Click="View_Click" Width="60" AutomationProperties.Name="展开或收起菜单"/>
   <TextBlock x:Name="TitileTextBlock" RelativePanel.RightOf="Hamburgertestbutton" FontSize="24" Text="Voice Tools" FontWeight="ExtraBold" Margin="16,5,0,0"/>
  </RelativePanel>
  <SplitView x:Name="View" Grid.Row="1" DisplayMode="CompactOverlay" OpenPaneLength="200" CompactPaneLength="60">
   <SplitView.Pane>
    <ListBox x:Name="Listbox" SelectionMode="Single" SelectionChanged="ChooseChanged">
     <ListBoxItem x:Name="HomePage" Tag="Pitch"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Text="&#xE1D6;" Margin="0,0,20,0"/><TextBlock Text="Voice" FontSize="24" Margin="5,3,0,0" SelectionChanged="TextBlock_SelectionChanged"/></StackPanel></ListBoxItem>
     <ListBoxItem Tag="Tone"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="MusicInfo" Width="36" Margin="0,0,20,0"/><TextBlock Text="音调" FontSize="24" Margin="5,3,0,0"/></StackPanel></ListBoxItem>
     <ListBoxItem Tag="Volume"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="Volume" Width="36" Margin="0,0,20,0"/><TextBlock Text="音量" FontSize="24" Margin="5,3,0,0"/></StackPanel></ListBoxItem>
     <ListBoxItem Tag="Analysis"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="Microphone" Width="36" Margin="0,0,20,0"/><TextBlock Text="分析" FontSize="24" Margin="5,3,0,0"/></StackPanel></ListBoxItem><ListBoxItem Tag="Stats"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="ViewAll" Width="36" Margin="0,0,20,0"/><TextBlock Text="统计" FontSize="24" Margin="5,3,0,0"/></StackPanel></ListBoxItem>
     <ListBoxItem x:Name="Settings" Tag="Settings"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="36" Text="&#xE115;" Margin="0,0,20,0"/><TextBlock Text="Settings" FontSize="24" Margin="5,3,0,0"/></StackPanel></ListBoxItem>
    </ListBox>
   </SplitView.Pane>
   <SplitView.Content><Frame x:Name="MainFrame"/></SplitView.Content>
  </SplitView>
 </Grid>
</Page>


