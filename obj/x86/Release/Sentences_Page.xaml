<Page x:ConnectionId='1' x:Class="VoiceTools.Sentences_Page" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA"                     >
 <Grid Padding="24" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8">
   <Button x:ConnectionId='7'                    AutomationProperties.Name="返回设置"><SymbolIcon Symbol="Back"/></Button>
   <TextBlock Text="建议语句库" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock x:ConnectionId='8' x:Name="LanguageText"/>
   <TextBlock Text="编辑完成后点击保存，未保存的修改不会生效。" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer x:ConnectionId='2' x:Name="RowsScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel x:ConnectionId='6' x:Name="Rows" Spacing="12"/>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Spacing="8">
   <TextBlock x:ConnectionId='3' x:Name="StatusText" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <Button x:ConnectionId='4'                   AutomationProperties.Name="新增语句" ToolTipService.ToolTip="新增语句"><SymbolIcon Symbol="Add"/></Button>
    <Button x:ConnectionId='5' Content="保存"                   />
   </StackPanel>
  </StackPanel>
 </Grid>
</Page>

