<Page x:Class="VoiceTools.Settings_Page" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F6FA" Loaded="Page_Loaded">
 <ScrollViewer><StackPanel Padding="24" Spacing="18" MaxWidth="780" HorizontalAlignment="Stretch">
  <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold"/>
  <ComboBox x:Name="LanguageChoice" Header="语言" SelectionChanged="Language_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="简体中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
  <TextBlock Text="练习语句和默认长文只使用所选语言；自定义文本按语言分别保存。" TextWrapping="Wrap" FontSize="12"/>
  <ToggleSwitch x:Name="GenderChoice" Header="性别（色块）标记" OnContent="显示" OffContent="隐藏" Toggled="Gender_Changed"/>
  <TextBlock Text="隐藏后使用中性色与数值区间，不改变统计结果。" TextWrapping="Wrap" FontSize="12"/>
  <ComboBox x:Name="ScaleChoice" Header="比例尺" SelectionChanged="Scale_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="ERB" Tag="ERB"/><ComboBoxItem Content="Mel" Tag="Mel"/><ComboBoxItem Content="Linear" Tag="Linear"/></ComboBox>
  <TextBlock Text="只改变频率坐标的间距，读数和区间阈值仍以 Hz 表示。" TextWrapping="Wrap" FontSize="12"/>
  <ComboBox x:Name="ReplayDuration" Header="回听时长" SelectionChanged="Duration_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="5 秒" Tag="5"/><ComboBoxItem Content="10 秒" Tag="10"/><ComboBoxItem Content="20 秒" Tag="20"/><ComboBoxItem Content="30 秒" Tag="30"/></ComboBox>
  <Button Content="建议语句库" Click="OpenSentences_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
  <TextBox x:Name="AnalysisText" Header="分析待读文本" AcceptsReturn="True" TextWrapping="Wrap" Height="220" MaxLength="50000" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Passage_Changed"/>
  <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="保存文本" Click="SaveText_Click"/><Button Content="恢复默认文本" Click="ResetText_Click"/></StackPanel>
  <TextBlock x:Name="TextStatus" TextWrapping="Wrap" FontSize="12"/>
  <ComboBox x:Name="InputChoice" Header="接收设备（麦克风）" DisplayMemberPath="Name" SelectionChanged="Input_Changed" HorizontalAlignment="Stretch"/>
  <ComboBox x:Name="OutputChoice" Header="播放设备" DisplayMemberPath="Name" SelectionChanged="Output_Changed" HorizontalAlignment="Stretch"/>
  <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click"/>
  <TextBlock Text="设备选择应用于实时分析、音调试听、长文录音和所有回听。设备断开时会提示重新选择。" TextWrapping="Wrap" FontSize="12"/>
  <TextBlock x:Name="DeviceStatus" TextWrapping="Wrap"/>
  <TextBlock Text="设置自动保存；长文编辑后请点击保存文本。" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</Page>
